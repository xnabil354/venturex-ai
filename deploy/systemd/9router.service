[Unit]
Description=9Router headless AI gateway (direct standalone server)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/.nvm/versions/node/v24.19.0/lib/node_modules/9router/app
EnvironmentFile=/etc/9router.env
Environment=HOME=/root
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=20128
Environment=DATA_DIR=/root/.9router
Environment=NODE_PATH=/root/.9router/runtime/node_modules:/root/.nvm/versions/node/v24.19.0/lib/node_modules/9router/app/node_modules
Environment=PATH=/root/.nvm/versions/node/v24.19.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/root/.nvm/versions/node/v24.19.0/bin/node --dns-result-order=ipv4first --max-old-space-size=2048 /root/.nvm/versions/node/v24.19.0/lib/node_modules/9router/app/custom-server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/.9router
StandardOutput=journal
StandardError=journal
SyslogIdentifier=9router

[Install]
WantedBy=multi-user.target
