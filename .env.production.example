# Copy this file to .env.production on the VPS and replace every placeholder.
NODE_ENV=production
APP_URL=https://your-domain.example
APP_PORT=3000
AUTH_TRUST_HOST=true

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Fresh databases only: initial admin password. Remove from this file after migration 024.
# Generate with: openssl rand -hex 32
ADMIN_BOOTSTRAP_PASSWORD=

POSTGRES_DB=venturex
POSTGRES_USER=venturex
# Generate with: openssl rand -hex 32. Use this same value in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
# Keep the hostname `postgres`; it is the Compose service name. Hex password needs no URL escaping.
DATABASE_URL=postgresql://venturex:replace-with-a-long-random-hex-password@postgres:5432/venturex

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000
