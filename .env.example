NODE_ENV=development
APP_URL=http://localhost:3000

# Local PostgreSQL connection only. Never commit real credentials.
# Matches compose.yaml defaults for local development; use venturex_test for isolated integration checks.
DATABASE_URL=postgresql://venturex:change-me@localhost:5432/venturex_dev
AUTH_SECRET=replace-with-a-local-random-secret
# Auth.js local development host validation.
AUTH_TRUST_HOST=true

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# Bright Data Google Trends candidate collection is opt-in and disabled by default.
BRIGHTDATA_TRENDS_ENABLED=false
# Server-only Bright Data API key. Leave blank unless collection is explicitly enabled.
BRIGHTDATA_TRENDS_API_KEY=
BRIGHTDATA_TRENDS_TIMEOUT_MS=10000

# Gemini may only be called by the isolated synthetic smoke harness in this batch.
# Normal application requests stay unavailable until synthetic provenance can be verified server-side.
AI_ANALYSIS_PROVIDER=gemini
AI_ANALYSIS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_MODEL=gemini-3.1-flash-lite
AI_ANALYSIS_TIMEOUT_MS=20000
AI_ANALYSIS_GEMINI_SYNTHETIC_SMOKE_ENABLED=false
AI_ANALYSIS_GEMINI_FREE_TIER_CONFIRMED=false
