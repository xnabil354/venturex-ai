NODE_ENV=development
APP_URL=http://localhost:3000

# Local PostgreSQL connection only. Never commit real credentials.
# Matches compose.yaml defaults for local development; use venturex_test for isolated integration checks.
DATABASE_URL=postgresql://venturex:change-me@localhost:5432/venturex_dev
# Replace with a unique random value of at least 32 characters. Opportunity source tokens require it.
AUTH_SECRET=replace-with-a-local-random-secret
# Auth.js local development host validation.
AUTH_TRUST_HOST=true

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# Bright Data Google Trends candidate collection is opt-in and disabled by default.
BRIGHTDATA_TRENDS_ENABLED=false
# Server-only Bright Data API key. Leave blank unless collection is explicitly enabled.
BRIGHTDATA_TRENDS_API_KEY=
BRIGHTDATA_TRENDS_TIMEOUT_MS=10000
# Authenticated /trends output is separately gated while source-display rights are checked.
VENTUREX_TRENDS_LIVE_PREVIEW_ENABLED=false
BRIGHTDATA_TRENDS_DISPLAY_RIGHTS_CONFIRMED=false
# Keep false until the account terms permit Bright Data results to be sent to 9Router.
NINEROUTER_BRIGHTDATA_PROCESSING_CONFIRMED=false
# Separate opt-in for SearchApi Google Trends Explore evidence sent to 9Router.
NINEROUTER_SEARCHAPI_PROCESSING_CONFIRMED=false

# Server-only 9Router configuration. HTTPS or a verified authenticated loopback tunnel is
# required by normal inference. Public HTTP remains rejected except for the exact server
# endpoint in a separately enabled local synthetic-only demonstration.
AI_PROVIDER=ninerouter
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
NINEROUTER_MODEL=cx/gpt-6-luna-xhigh
NINEROUTER_LOOPBACK_TUNNEL_CONFIRMED=false
# Direct local Opportunity Finder loopback HTTP only; requires NODE_ENV=development,
# the exact loopback host, port 20128, /v1 path, and no URL credentials.
NINEROUTER_ALLOW_LOOPBACK_HTTP_DEV_ONLY=false
# Keep false by default. In development, true can admit the exact configured public HTTP
# endpoint for isolated local synthetic testing. Opportunity Finder profile inference rejects
# public HTTP even when this switch is enabled. For compatibility, this opt-in can permit only
# the validated loopback endpoint in the Opportunity Finder; the dedicated flag above is preferred.
# The bearer key and request context travel without encryption over public HTTP.
NINEROUTER_ALLOW_PUBLIC_HTTP_DEV_ONLY=false
# Local development maximum; production must stay below its verified platform deadline.
AI_ANALYSIS_TIMEOUT_MS=60000
# Opportunity Finder has a separate bounded deadline for the xhigh profile analysis path.
AI_OPPORTUNITY_FINDER_TIMEOUT_MS=120000
AI_ANALYSIS_NINEROUTER_SYNTHETIC_SMOKE_ENABLED=false
# Authenticated Trend Signal inference remains off by default.
AI_ANALYSIS_TRENDS_USER_INFERENCE_ENABLED=false
# Local synthetic demo only; the launcher forces MOCK unless separately authorized.
AI_ANALYSIS_SYNTHETIC_DEMO_PROVIDER_MODE=MOCK
AI_ANALYSIS_SYNTHETIC_DEMO_LIVE_AUTHORIZED=false
# Local Bright Data source preview stays disabled unless the private launcher is explicitly authorized.
VENTUREX_LOCAL_DEMO_BRIGHTDATA_LIVE_AUTHORIZED=false
VENTUREX_LOCAL_DEMO_BRIGHTDATA_PRECHECK_CONFIRMED=false

# SearchApi Google Trends Explore; provider requests are server-side and user-triggered.
TREND_RADAR_SEARCHAPI_ENABLED=false
SEARCHAPI_API_KEY=
SEARCHAPI_BASE_URL=https://www.searchapi.io/api/v1/search
SEARCHAPI_TIMEOUT_MS=10000
# Related queries can take longer than interest-over-time data.
SEARCHAPI_RELATED_QUERIES_TIMEOUT_MS=30000
# GEO_MAP can take longer than the other Trend Radar datasets.
SEARCHAPI_GEO_MAP_TIMEOUT_MS=30000
# Keep the product-approved -420 offset. SearchApi documents an offset and notes that it affects results,
# but the sign convention for Asia/Jakarta has not been independently verified.
TREND_RADAR_TZ_MINUTES=-420
TREND_RADAR_CATEGORY=0
# In-process cache only; entries are not shared across application instances.
TREND_RADAR_CACHE_TTL_SHORT_SECONDS=300
TREND_RADAR_CACHE_TTL_LONG_SECONDS=3600
TREND_RADAR_MAX_PROVIDER_REQUESTS_PER_DAY=100

# Web Push: local development may use `pnpm notifications:setup` instead.
# Production: use one stable key pair across web and worker, and a monitored contact.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
